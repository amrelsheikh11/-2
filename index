<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام إصدار إيصالات المستحقات الذكي</title>
    <link href="https://googleapis.com" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --secondary: #3b82f6;
            --accent: #0ea5e9;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --bg-panel: #ffffff;
        }

        * {
            box-sizing: border-box;
            font-family: 'Cairo', sans-serif;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #f1f5f9;
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
        }

        /* تقسيم الشاشة إلى جزأين: إدخال على اليمين ومعاينة على اليسار */
        .app-container {
            display: flex;
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 30px;
            gap: 30px;
        }

        /* لوحة إدخال البيانات - الجانب الأيمن */
        .input-panel {
            flex: 1;
            background: var(--bg-panel);
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            border: 1px solid var(--border);
            height: fit-content;
        }

        .panel-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--border);
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .input-group.row-fluid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        label {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-dark);
        }

        input, select {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            background: #f8fafc;
            transition: all 0.2s ease;
        }

        input:focus, select:focus {
            border-color: var(--secondary);
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
        }

        /* لوحة معاينة الإيصال المصغر - الجانب الأيسر */
        .preview-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-start;
        }

        /* تصغير حجم بطاقة الإيصال البصري وجعلها أنيقة جداً */
        .receipt-card {
            background: #ffffff;
            width: 100%;
            max-width: 440px; /* حجم مصغر وشيك للويب والطباعة */
            padding: 35px 30px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
            border: 1px solid var(--border);
            position: relative;
            border-top: 8px solid var(--primary);
        }

        .receipt-header {
            text-align: center;
            margin-bottom: 25px;
            border-bottom: 1px dashed var(--border);
            padding-bottom: 15px;
        }

        .receipt-header h2 {
            font-size: 18px;
            color: var(--primary);
            font-weight: 800;
        }

        .receipt-header p {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .receipt-title-box {
            margin: 15px 0;
            text-align: center;
        }

        .receipt-title-box h1 {
            font-size: 15px;
            background: #f0f4ff;
            color: var(--primary);
            padding: 4px 16px;
            border-radius: 50px;
            display: inline-block;
            font-weight: 700;
        }

        .receipt-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 11px 0;
            border-bottom: 1px solid #f8fafc;
            font-size: 13px;
        }

        .receipt-row:last-of-type {
            border-bottom: none;
        }

        .receipt-lbl {
            color: var(--text-muted);
            font-weight: 500;
        }

        .receipt-val {
            color: var(--text-dark);
            font-weight: 700;
            text-align: left;
        }

        .receipt-amount-box {
            background: #f0fdf4;
            border: 1px dashed #bbf7d0;
            padding: 16px;
            border-radius: 12px;
            text-align: center;
            margin: 20px 0;
        }

        .view-num {
            font-size: 28px;
            font-weight: 800;
            color: #16a34a;
            display: block;
        }

        .view-words {
            font-size: 12px;
            color: #15803d;
            font-weight: 700;
            margin-top: 4px;
            background: #ffffff;
            padding: 4px 8px;
            border-radius: 6px;
            display: inline-block;
            border: 1px solid #f0fdf4;
        }

        .receipt-footer-signatures {
            margin-top: 25px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            text-align: center;
            font-size: 12px;
            border-top: 1px dashed var(--border);
            padding-top: 15px;
        }

        .sig-box p {
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 35px;
        }

        .sig-line {
            width: 70%;
            margin: 0 auto;
            border-bottom: 1px solid #cbd5e1;
        }

        .action-area {
            margin-top: 20px;
            width: 100%;
            max-width: 440px;
        }

        .btn-submit {
            width: 100%;
            background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
            color: white;
            border: none;
            padding: 12px;
            font-size: 15px;
            font-weight: 700;
            border-radius: 10px;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(30, 58, 138, 0.15);
            transition: all 0.2s ease;
        }

        .btn-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 15px rgba(30, 58, 138, 0.25);
        }

        /* إعدادات الطباعة الاستثنائية: إخفاء لوحة التحكم اليمنى وطباعة الإيصال الصغير فقط في منتصف الصفحة */
        @media print {
            body {
                background: white;
                justify-content: center;
                align-items: center;
                padding: 0;
            }
            .input-panel, .action-area {
                display: none !important;
            }
            .preview-panel {
                width: 100%;
            }
            .receipt-card {
                box-shadow: none !important;
                border: 1px solid #cbd5e1 !important;
                max-width: 440px !important;
                margin: 0 auto;
            }
        }

        @media (max-width: 900px) {
            .app-container {
                flex-direction: column;
                padding: 15px;
            }
            .receipt-card {
                max-width: 100%;
            }
        }
    </style>
</head>
<body>

    <div class="app-container">
        
        <!-- لوحة الإدخال (الجانب الأيمن) -->
        <div class="input-panel">
            <div class="panel-title">✍️ إدخال بيانات المستحقات</div>
